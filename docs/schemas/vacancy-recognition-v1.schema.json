{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reframecv:vacancy-recognition:1",
  "title": "VacancyRecognitionResult",
  "description": "Source recognition result adapted from divo-resume/parseJob.schema.json. This is not a persisted Vacancy or VacancyAttachment. The contract version is identified by the schema ID.",
  "type": "object",
  "properties": {
    "jobTitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "jobDescription": {
      "type": [
        "string",
        "null"
      ]
    },
    "company": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "keywords": {
      "$ref": "#/$defs/RecognizedItems"
    },
    "responsibilities": {
      "$ref": "#/$defs/RecognizedItems"
    },
    "requirements": {
      "$ref": "#/$defs/RecognizedItems"
    },
    "nice_to_have": {
      "$ref": "#/$defs/RecognizedItems"
    }
  },
  "required": [
    "jobTitle",
    "jobDescription",
    "company",
    "url",
    "keywords",
    "responsibilities",
    "requirements",
    "nice_to_have"
  ],
  "additionalProperties": false,
  "$defs": {
    "RecognizedItems": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
